<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bujo_background"
    android:descendantFocusability="beforeDescendants">

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- 1. Top Bar: Search / Add Bar (BB10 Style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="@color/bb10_bottom_bar_bg">

        <AutoCompleteTextView
            android:id="@+id/auto_exercise"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/surface"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:hint="@string/ui_add_a_workout_or_search_efc9eb"
            android:textSize="16sp"
            android:imeOptions="actionDone"
            android:inputType="textCapWords"
            android:completionThreshold="1"
            android:singleLine="true" />

        <Button
            android:id="@+id/btn_add_set"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/ui_log_set_94de29"
            android:textSize="12sp"
            android:textColor="@color/bujo_text"
            android:background="@drawable/shape_bb10_btn_layer"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bujo_divider"/>

    <!-- 2. Inputs for Weight, Reps -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:background="@color/surface">

        <EditText
            android:id="@+id/et_weight"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            android:hint="@string/ui_weight_69c0b8"
            android:textSize="14sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@android:color/transparent"/>

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/bujo_divider" />

        <EditText
            android:id="@+id/et_reps"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:inputType="number"
            android:hint="@string/ui_reps_702045"
            android:textSize="14sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@android:color/transparent"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bujo_divider"/>

    <!-- 3. Notes -->
    <EditText
        android:id="@+id/et_note"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:hint="@string/ui_notes_fee3c9"
        android:textSize="14sp"
        android:inputType="textCapSentences"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@color/surface"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bujo_divider"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:background="@color/bujo_background" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bujo_divider"/>

    <!-- 3. Timer (Settings style row) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/surface">

        <!-- Timer Label/Value on the left -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_session_timer_e59efe"
                android:textColor="@color/bujo_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/bb10_folder_blue"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Controls on the right -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btn_timer_toggle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_bb10_play"
                app:tint="@color/bujo_text"
                android:background="?android:attr/selectableItemBackground"
                android:padding="4dp"  android:contentDescription="@string/ui_start_or_pause_workout_timer_1b78ac" />

            <ImageView
                android:id="@+id/btn_timer_reset"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_bb10_reset"
                app:tint="@color/bujo_text_secondary"
                android:background="?android:attr/selectableItemBackground"
                android:padding="4dp"  android:contentDescription="@string/ui_reset_workout_timer_91aa67" />

        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bujo_divider"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:background="@color/bujo_background" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bujo_divider"/>

    <!-- 4. Section Header: Today's Log (Settings Style Separator) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_today_s_log_273b2f"
        android:textColor="@color/bb10_section_header_text"
        android:textSize="11sp"
        android:textStyle="bold"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@color/bb10_section_header_bg" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bujo_divider"/>

</LinearLayout>
