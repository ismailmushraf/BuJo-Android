<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bujo_background">

    <!-- Header removed based on updated design plan -->



    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Task Lists"
        android:padding="8dp"
        android:textStyle="bold"
        android:textColor="@color/bujo_text_secondary"
        android:textSize="16sp"
        android:background="@color/white" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bujo_divider"/>

    <!-- Grid View for Folders -->
    <GridView
        android:id="@+id/gv_projects"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:numColumns="5"
        android:horizontalSpacing="4dp"
        android:verticalSpacing="4dp"
        android:padding="4dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

</LinearLayout>
