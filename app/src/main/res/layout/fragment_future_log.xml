<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface"
    android:animateLayoutChanges="true">

    <!-- Top Month Header Bar -->
    <LinearLayout
        android:id="@+id/month_controls"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/surface">

        <TextView
            android:id="@+id/tv_calendar_month"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/bujo_text"
            android:textSize="22sp"
            android:text="@string/ui_september_2026_f17bba" />

    </LinearLayout>

    <!-- Top Green Accent Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/literal_769a30" />

    <!-- Days of Week Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:background="@color/surface">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="@string/ui_mon_24b2a0" android:textStyle="bold" android:textColor="@color/bujo_text" android:textSize="12sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="@string/ui_tue_529541" android:textStyle="bold" android:textColor="@color/bujo_text" android:textSize="12sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="@string/ui_wed_23408b" android:textStyle="bold" android:textColor="@color/bujo_text" android:textSize="12sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="@string/ui_thu_3593cc" android:textStyle="bold" android:textColor="@color/bujo_text" android:textSize="12sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="@string/ui_fri_bbd6e3" android:textStyle="bold" android:textColor="@color/bujo_text" android:textSize="12sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="@string/ui_sat_6b782d" android:textStyle="bold" android:textColor="@color/bujo_text" android:textSize="12sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="@string/ui_sun_48c98c" android:textStyle="bold" android:textColor="@color/bujo_text" android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bujo_divider" />

    <!-- Full Month Calendar Grid (Stretches to fill 100% of available height) -->
    <com.ismailmushraf.bujo.utils.CalendarGridView
        android:id="@+id/grid_calendar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:horizontalSpacing="0dp"
        android:numColumns="7"
        android:verticalSpacing="0dp"
        android:scrollbars="none"
        android:background="@color/surface" />

    <!-- Month View Bottom Selected Date Bar (Sits directly underneath Row 6) -->
    <LinearLayout
        android:id="@+id/month_selected_bar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/surface"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tv_month_selected_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/bujo_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_week_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/bujo_text_secondary"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/iv_month_arrow"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_bb10_chevron_up"  android:contentDescription="@null" android:importantForAccessibility="no" />

    </LinearLayout>

    <!-- Agenda View Container (When Day is Selected) -->
    <LinearLayout
        android:id="@+id/agenda_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Single Week Grid Bar -->
        <GridView
            android:id="@+id/grid_week"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:horizontalSpacing="0dp"
            android:numColumns="7"
            android:scrollbars="none"
            android:verticalSpacing="0dp"
            android:background="@color/surface" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bujo_divider" />

        <!-- Selected Date Banner -->
        <LinearLayout
            android:id="@+id/layout_selected_date_banner"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_selected_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/bujo_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_week_number_banner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/bujo_text_secondary"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/iv_week_arrow"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_bb10_chevron_down"  android:contentDescription="@null" android:importantForAccessibility="no" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bujo_divider" />

        <!-- Task Agenda List -->
        <ListView
            android:id="@+id/list_agenda"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@color/bujo_divider"
            android:dividerHeight="1dp" />

    </LinearLayout>

</LinearLayout>
