<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/shape_bb10_confirm_card">

    <!-- Top Section: White Title and Description -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/surface">

        <TextView
            android:id="@+id/tv_confirm_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/bujo_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_confirm_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/bujo_text_secondary"
            android:textSize="15sp"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bujo_divider" />

    <!-- Bottom Section: Light Grey Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bb10_dialog_footer">

        <!-- Positive Action Button (e.g. Delete / Confirm) -->
        <TextView
            android:id="@+id/btn_confirm_positive"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="@string/ui_delete_f6fdbe"
            android:textColor="@color/literal_d32f2f"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bujo_divider" />

        <!-- Negative Action Button (e.g. Cancel) -->
        <TextView
            android:id="@+id/btn_confirm_negative"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="@string/ui_cancel_77dfd2"
            android:textColor="@color/bujo_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

    </LinearLayout>

</LinearLayout>
