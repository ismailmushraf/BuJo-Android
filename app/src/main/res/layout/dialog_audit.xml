<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/shape_bujo_page"
    android:padding="24dp"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_symbol_9b0a15"
        android:textSize="40sp" />

    <TextView
        android:id="@+id/audit_penalty_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_0_pts_d8f144"
        android:textColor="@color/literal_f44336"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/audit_reason_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_discipline_penalty_a31ece"
        android:textColor="@color/bujo_text"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginTop="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_every_task_added_is_a_commitment_points_are_dedu_8e1f6e"
        android:textColor="@color/bujo_text_secondary"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_audit_ok"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_i_will_do_better_8a29d9"
        android:layout_marginTop="20dp"
        android:background="@drawable/shape_bujo_box"
        android:textColor="@color/bujo_text"
        android:textAllCaps="true"
        android:textStyle="bold"
        android:minHeight="48dp" />

</LinearLayout>
