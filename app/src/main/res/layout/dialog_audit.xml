<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/shape_bujo_page"
    android:padding="24dp"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📉"
        android:textSize="40sp" />

    <TextView
        android:id="@+id/audit_penalty_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-0 pts"
        android:textColor="#F44336"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/audit_reason_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Discipline Penalty"
        android:textColor="@color/bujo_text"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginTop="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Every task added is a commitment. Points are deducted for uncompleted tasks at the end of each day."
        android:textColor="@color/bujo_text_secondary"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_audit_ok"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="I will do better"
        android:layout_marginTop="20dp"
        android:background="@drawable/shape_bujo_box"
        android:textColor="@color/bujo_text"
        android:textAllCaps="true"
        android:textStyle="bold"
        android:minHeight="48dp" />

</LinearLayout>
