<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bujo_background">

    <!-- Top Action Bar (BB10 Style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/surface">

        <TextView
            android:id="@+id/tv_progress_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_habit_progress_f52d0a"
            android:textColor="@color/bujo_text"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/bb10_blue" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bujo_divider" />

    <!-- Top Section: Habit Details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/surface">

        <TextView
            android:id="@+id/tv_progress_habit_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/bujo_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_progress_habit_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/bujo_text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tv_progress_habit_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/bujo_text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bujo_divider" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_commitment_progress_grid_4e24eb"
        android:padding="12dp"
        android:textStyle="bold"
        android:textColor="@color/bujo_text_secondary"
        android:textSize="14sp"
        android:background="@color/bb10_section_header_bg" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bujo_divider" />

    <!-- Commitment Days Grid -->
    <GridView
        android:id="@+id/gv_habit_progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:numColumns="4"
        android:horizontalSpacing="8dp"
        android:verticalSpacing="8dp"
        android:padding="12dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

</LinearLayout>
