<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="420dp"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Plan for:"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/bujo_text_secondary"
        android:paddingBottom="8dp"/>

    <RadioGroup
        android:id="@+id/rg_plan_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:paddingBottom="12dp">
        <RadioButton
            android:id="@+id/rb_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:checked="true"
            android:layout_marginRight="24dp"/>
        <RadioButton
            android:id="@+id/rb_tomorrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tomorrow"/>
    </RadioGroup>

    <TextView
        android:id="@+id/tv_available_hours"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Available working hours: 0h"
        android:textSize="12sp"
        android:textColor="@color/bujo_text_secondary"
        android:paddingBottom="8dp"
        android:gravity="center"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bujo_divider"
        android:layout_marginBottom="8dp"/>

    <ListView
        android:id="@+id/lv_recommendations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:choiceMode="multipleChoice"
        android:divider="@color/bujo_divider"
        android:dividerHeight="1dp"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbars="vertical"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />

</LinearLayout>
