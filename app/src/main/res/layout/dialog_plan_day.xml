<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/shape_bb10_confirm_card">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:background="@color/surface">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_plan_sessions_7efc64"
            android:textColor="@color/bujo_text"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bujo_divider" />

    <Button android:id="@+id/btn_plan_coach" style="@style/CoachButton"
        android:text="@string/coach_plan_with" />

    <!-- Content Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/surface">

        <RadioGroup
            android:id="@+id/rg_plan_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:paddingBottom="4dp">
            <RadioButton
                android:id="@+id/rb_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_today_24345a"
                android:checked="true"
                android:textColor="@color/bujo_text"
                android:layout_marginEnd="24dp"/>
            <RadioButton
                android:id="@+id/rb_tomorrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/bujo_text"
                android:text="@string/ui_tomorrow_1948bf"/>
        </RadioGroup>

        <TextView
            android:id="@+id/tv_available_hours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_available_working_hours_0h_a5d615"
            android:textSize="12sp"
            android:textColor="@color/bujo_text_secondary"
            android:paddingBottom="6dp"
            android:gravity="center"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bujo_divider"
            android:layout_marginBottom="6dp"/>

        <ListView
            android:id="@+id/lv_recommendations"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:choiceMode="multipleChoice"
            android:divider="@color/bujo_divider"
            android:dividerHeight="1dp"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbars="vertical"
            android:clipToPadding="false" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bujo_divider" />

    <!-- Bottom Buttons Section (Horizontal Side-by-Side) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/bb10_dialog_footer">

        <TextView
            android:id="@+id/btn_plan_cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/ui_cancel_77dfd2"
            android:textColor="@color/bujo_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/bujo_divider" />

        <TextView
            android:id="@+id/btn_plan_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/ui_add_to_log_a68591"
            android:textColor="@color/bb10_blue"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

    </LinearLayout>

</LinearLayout>
