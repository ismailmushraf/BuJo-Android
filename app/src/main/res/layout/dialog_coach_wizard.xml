<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shape_bb10_confirm_card"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:padding="18dp"
        android:text="PLAN DAY"
        android:textColor="@color/bujo_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bujo_divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <ScrollView
        android:id="@+id/coach_step_mood"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bb10_bottom_bar_bg"
            android:orientation="vertical"
            android:padding="18dp">

        <TextView
            style="@style/CoachText"
            android:text="What is your mood?"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/coach_wizard_mood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/mood_low"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Low" />

            <RadioButton
                android:id="@+id/mood_ok"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Okay" />

            <RadioButton
                android:id="@+id/mood_good"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Good" />
        </RadioGroup>
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/coach_step_energy"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bb10_bottom_bar_bg"
            android:orientation="vertical"
            android:padding="18dp">

        <TextView
            style="@style/CoachText"
            android:text="How is your energy?"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/coach_wizard_energy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/energy_low"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Low" />

            <RadioButton
                android:id="@+id/energy_medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Medium" />

            <RadioButton
                android:id="@+id/energy_high"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="High" />
        </RadioGroup>
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/coach_step_time"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bb10_bottom_bar_bg"
            android:orientation="vertical"
            android:padding="18dp">

        <TextView
            style="@style/CoachText"
            android:text="How many minutes can you give this plan?"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@color/bb10_bottom_bar_bg"
            android:padding="4dp">

            <EditText
                android:id="@+id/coach_wizard_minutes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/surface"
                android:hint="Minutes"
                android:inputType="number"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:text="30"
                android:textColor="@color/bujo_text"
                android:textColorHint="@color/bujo_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            style="@style/CoachText"
            android:text="Anything on your mind? (optional)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/bb10_bottom_bar_bg"
            android:padding="4dp">

            <EditText
                android:id="@+id/coach_wizard_note"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="@color/surface"
                android:gravity="top"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="1000"
                android:padding="8dp"
                android:textColor="@color/bujo_text"
                android:textColorHint="@color/bujo_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/coach_step_results"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bb10_bottom_bar_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/coach_wizard_message"
                style="@style/CoachText" />

            <TextView
                style="@style/CoachText"
                android:text="SELECT TASKS TO ADD TO TODAY"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/coach_wizard_suggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/coach_wizard_status"
        style="@style/CoachText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/bb10_bottom_bar_bg"
        android:padding="12dp"
        android:visibility="gone" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bujo_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/bb10_dialog_footer"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/coach_wizard_cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="@color/bujo_text"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/bujo_divider" />

        <TextView
            android:id="@+id/coach_wizard_back"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Back"
            android:textColor="@color/bujo_text"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/bujo_divider" />

        <TextView
            android:id="@+id/coach_wizard_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Next"
            android:textColor="@color/bb10_blue"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/bujo_divider" />

        <TextView
            android:id="@+id/coach_wizard_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Add selected"
            android:textColor="@color/bb10_blue"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
