<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shape_bb10_confirm_card"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/nova_avatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="Nova, your AI Coach"
            android:scaleType="centerCrop"
            android:src="@drawable/nova_avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/coach_wizard_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOVA"
                android:textColor="@color/bujo_text"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/nova_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Your AI Coach"
                android:textColor="@color/bb10_blue"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/coach_progress"
            android:layout_width="48dp"
            android:layout_height="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View android:id="@+id/coach_progress_1" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@color/bb10_blue" />
            <View android:id="@+id/coach_progress_2" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:background="@color/bujo_divider" />
        </LinearLayout>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/bujo_divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/coach_step_mood"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bb10_bottom_bar_bg"
            android:orientation="vertical">

            <ScrollView
                android:id="@+id/coach_chat_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">
                <LinearLayout
                    android:id="@+id/coach_chat_messages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp" />
            </ScrollView>

            <LinearLayout
                android:id="@+id/coach_chat_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bb10_bottom_bar_bg"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:id="@+id/coach_chat_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="horizontal" />

                <LinearLayout
                    style="@style/Widget.BuJo.TextInput.Container"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp">

                    <EditText
                        style="@style/Widget.BuJo.TextInput"
                        android:id="@+id/coach_chat_reply"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="Write a reply for Nova…"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences"
                        android:maxLength="1000"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/coach_chat_schedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/coach_wizard_start_time"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/shape_bujo_box"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:textColor="@color/bujo_text"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/coach_wizard_end_time"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/shape_bujo_box"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:textColor="@color/bujo_text"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Retained for the existing render contract; the chat replaces the old second form page. -->
        <View android:id="@+id/coach_step_time" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />

        <ScrollView
            android:id="@+id/coach_step_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bb10_bottom_bar_bg"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_coach_bubble"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <View android:layout_width="3dp" android:layout_height="match_parent" android:background="@color/bb10_blue" android:layout_marginEnd="10dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/coach_label_ai" android:textColor="@color/bb10_blue" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/coach_wizard_message" style="@style/CoachText" android:paddingTop="4dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:paddingBottom="0dp" android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/coach_results_selection_label" style="@style/CoachText" android:text="SELECT TASKS TO ADD TO TODAY" android:textColor="@color/bujo_text_secondary" android:textSize="11sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/coach_wizard_suggestions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp" />
                <Button style="@style/Widget.BuJo.Button.Compact" android:id="@+id/coach_refine_simpler" android:layout_width="match_parent" android:layout_height="40dp" android:text="Refine" android:textSize="13sp" />
                <Button android:id="@+id/coach_refine_work" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <Button android:id="@+id/coach_refine_low_effort" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="49dp" android:background="@color/bb10_dialog_footer" android:orientation="vertical">
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/bujo_divider" />
        <LinearLayout android:id="@+id/coach_footer_step1" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
            <TextView android:id="@+id/coach_wizard_cancel_step1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Cancel" android:textColor="@color/bujo_text" android:textStyle="bold" />
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/bujo_divider" />
            <TextView android:id="@+id/coach_wizard_next_step1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Next" android:textColor="@color/bb10_blue" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/coach_footer_step2" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/coach_wizard_cancel_step2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Cancel" />
            <TextView android:id="@+id/coach_wizard_back_step2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Back" />
            <TextView android:id="@+id/coach_wizard_next_step2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Next" />
        </LinearLayout>
        <LinearLayout android:id="@+id/coach_footer_step3" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/coach_wizard_cancel_step3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Cancel" android:textColor="@color/bujo_text" android:textStyle="bold" />
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/bujo_divider" />
            <TextView android:id="@+id/coach_wizard_add_step3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Add selected" android:textColor="@color/bb10_blue" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
