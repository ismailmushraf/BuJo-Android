<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shape_bb10_confirm_card"
    android:orientation="vertical">

    <TextView
        android:id="@+id/coach_wizard_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:padding="18dp"
        android:text="@string/coach_header_step1"
        android:textColor="@color/bujo_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bujo_divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <!-- Step 1: Mood & Energy Check-in -->
    <ScrollView
        android:id="@+id/coach_step_mood"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bb10_bottom_bar_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Coach Chat Bubble with BB10 Accent Indicator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_coach_bubble"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="@color/bb10_blue"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/coach_label_ai"
                        android:textColor="@color/bb10_blue"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/CoachText"
                        android:paddingTop="4dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:paddingBottom="0dp"
                        android:text="@string/coach_prompt_mood_energy"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/CoachText"
                android:text="@string/coach_label_mood"
                android:textColor="@color/bujo_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/coach_wizard_mood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/mood_low"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:background="@drawable/selector_chip_bg"
                    android:textColor="@color/bujo_text"
                    android:textSize="13sp"
                    android:text="@string/coach_mood_low" />

                <TextView
                    android:id="@+id/mood_ok"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:background="@drawable/selector_chip_bg"
                    android:textColor="@color/bujo_text"
                    android:textSize="13sp"
                    android:text="@string/coach_mood_ok" />

                <TextView
                    android:id="@+id/mood_good"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:background="@drawable/selector_chip_bg"
                    android:textColor="@color/bujo_text"
                    android:textSize="13sp"
                    android:text="@string/coach_mood_good" />
            </LinearLayout>

            <TextView
                style="@style/CoachText"
                android:text="@string/coach_label_energy"
                android:textColor="@color/bujo_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/coach_wizard_energy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/energy_low"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:background="@drawable/selector_chip_bg"
                    android:textColor="@color/bujo_text"
                    android:textSize="13sp"
                    android:text="@string/coach_energy_low" />

                <TextView
                    android:id="@+id/energy_medium"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:background="@drawable/selector_chip_bg"
                    android:textColor="@color/bujo_text"
                    android:textSize="13sp"
                    android:text="@string/coach_energy_med" />

                <TextView
                    android:id="@+id/energy_high"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:background="@drawable/selector_chip_bg"
                    android:textColor="@color/bujo_text"
                    android:textSize="13sp"
                    android:text="@string/coach_energy_high" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Step 2: Time & Notes -->
    <ScrollView
        android:id="@+id/coach_step_time"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bb10_bottom_bar_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Coach Chat Bubble with BB10 Accent Indicator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_coach_bubble"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="@color/bb10_blue"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/coach_label_ai"
                        android:textColor="@color/bb10_blue"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/CoachText"
                        android:paddingTop="4dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:paddingBottom="0dp"
                        android:text="@string/coach_prompt_time_notes"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/CoachText"
                android:text="@string/coach_label_minutes"
                android:textColor="@color/bujo_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                style="@style/Widget.BuJo.TextInput.Container"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp">

                <EditText
                    style="@style/Widget.BuJo.TextInput"
                    android:id="@+id/coach_wizard_minutes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/coach_hint_minutes"
                    android:inputType="number"
                    android:singleLine="true"
                    android:text="30" />
            </LinearLayout>

            <TextView
                style="@style/CoachText"
                android:text="@string/coach_label_notes"
                android:textColor="@color/bujo_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                style="@style/Widget.BuJo.TextInput.Container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <EditText
                    style="@style/Widget.BuJo.TextInput.Multiline"
                    android:id="@+id/coach_wizard_note"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="top"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="1000" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Step 3: Results & Refine -->
    <ScrollView
        android:id="@+id/coach_step_results"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bb10_bottom_bar_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Coach Response Speech Bubble with BB10 Accent Indicator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_coach_bubble"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="@color/bb10_blue"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/coach_label_ai"
                        android:textColor="@color/bb10_blue"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/coach_wizard_message"
                        style="@style/CoachText"
                        android:paddingTop="4dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:paddingBottom="0dp"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/coach_results_selection_label"
                style="@style/CoachText"
                android:text="SELECT TASKS TO ADD TO TODAY"
                android:textColor="@color/bujo_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/coach_wizard_suggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp" />

            <!-- Refine Plan Panel -->
            <TextView
                style="@style/CoachText"
                android:text="@string/coach_refine_title"
                android:textColor="@color/bujo_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <Button
                    style="@style/Widget.BuJo.Button.Compact"
                    android:id="@+id/coach_refine_simpler"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="@string/coach_refine_simpler"
                    android:textSize="11sp" />

                <Button
                    style="@style/Widget.BuJo.Button.Compact"
                    android:id="@+id/coach_refine_work"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:text="@string/coach_refine_work"
                    android:textSize="11sp" />

                <Button
                    style="@style/Widget.BuJo.Button.Compact"
                    android:id="@+id/coach_refine_low_effort"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="@string/coach_refine_low_effort"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    </FrameLayout>

    <TextView
        android:id="@+id/coach_wizard_status"
        style="@style/CoachText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bb10_bottom_bar_bg"
        android:padding="12dp"
        android:textColor="@color/bb10_blue"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="49dp"
        android:background="@color/bb10_dialog_footer"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bujo_divider" />

        <!-- Separate rows avoid remeasuring hidden weighted controls on older Android. -->
        <LinearLayout
            android:id="@+id/coach_footer_step1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/coach_wizard_cancel_step1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Cancel"
                android:textColor="@color/bujo_text"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/bujo_divider" />

            <TextView
                android:id="@+id/coach_wizard_next_step1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Next"
                android:textColor="@color/bb10_blue"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/coach_footer_step2"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/coach_wizard_cancel_step2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Cancel"
                android:textColor="@color/bujo_text"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/bujo_divider" />

            <TextView
                android:id="@+id/coach_wizard_back_step2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Back"
                android:textColor="@color/bujo_text"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/bujo_divider" />

            <TextView
                android:id="@+id/coach_wizard_next_step2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Next"
                android:textColor="@color/bb10_blue"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/coach_footer_step3"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/coach_wizard_cancel_step3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Cancel"
                android:textColor="@color/bujo_text"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/bujo_divider" />

            <TextView
                android:id="@+id/coach_wizard_add_step3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Add selected"
                android:textColor="@color/bb10_blue"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
