<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top Screen Header Area Removed, moved to AppBar -->
    <View
        android:id="@+id/header_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="16dp"
        android:background="@color/bujo_divider"/>

    <!-- Main Active List Window -->
    <ListView
        android:id="@+id/lv_daily_bullets"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/bujo_divider"
        android:dividerHeight="1dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@drawable/shape_bujo_box"
            android:gravity="center_vertical">

            <!-- New Emoji Button -->
            <TextView
                android:id="@+id/btn_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📝"
                android:textSize="22sp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <EditText
                android:id="@+id/et_new_entry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Type new task..."
                android:imeOptions="actionDone"
                android:inputType="textCapSentences"
                android:singleLine="true" />

            <!-- New Event Button -->
            <TextView
                android:id="@+id/btn_add_event"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="📅"
                android:textSize="22sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_plan_tomorrow"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Plan Day"
            android:textSize="12sp"
            android:enabled="true"
            android:layout_marginLeft="8dp"
            android:background="@drawable/shape_bujo_box"
            android:textColor="@color/bujo_text" />
    </LinearLayout>

</LinearLayout>
