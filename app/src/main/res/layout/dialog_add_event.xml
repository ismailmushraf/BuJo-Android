<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/bujo_background">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_schedule_event_cf0765"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/bujo_text_secondary"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <EditText
            style="@style/Widget.BuJo.TextInput"
            android:id="@+id/et_event_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ui_event_name_8269fa"
            android:textSize="18sp"
            android:textColor="@color/bujo_text"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:inputType="textCapSentences"
            android:singleLine="true"/>

        <EditText
            style="@style/Widget.BuJo.TextInput.Multiline"
            android:id="@+id/et_event_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ui_description_optional_f1da5c"
            android:textSize="16sp"
            android:textColor="@color/bujo_text"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2"
            android:gravity="top"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <Button
                style="@style/Widget.BuJo.Button.Standard"
                android:id="@+id/btn_event_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="72dp"
                android:text="@string/ui_set_date_57b42b"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginEnd="4dp"
                android:textColor="@color/bujo_text"/>

            <Button
                style="@style/Widget.BuJo.Button.Standard"
                android:id="@+id/btn_event_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="72dp"
                android:text="@string/ui_set_time_34caeb"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginStart="4dp"
                android:textColor="@color/bujo_text"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
