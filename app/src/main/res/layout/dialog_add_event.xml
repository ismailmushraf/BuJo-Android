<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/bujo_background">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SCHEDULE EVENT"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/bujo_text_secondary"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/et_event_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Event Name"
            android:textSize="18sp"
            android:textColor="@color/bujo_text"
            android:background="@drawable/shape_bujo_box"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:inputType="textCapSentences"
            android:singleLine="true"/>

        <EditText
            android:id="@+id/et_event_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Description (Optional)"
            android:textSize="16sp"
            android:textColor="@color/bujo_text"
            android:background="@drawable/shape_bujo_box"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2"
            android:gravity="top"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <Button
                android:id="@+id/btn_event_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="72dp"
                android:text="Set Date"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginRight="4dp"
                android:background="@drawable/shape_bujo_box"
                android:textColor="@color/bujo_text"/>

            <Button
                android:id="@+id/btn_event_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="72dp"
                android:text="Set Time"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginLeft="4dp"
                android:background="@drawable/shape_bujo_box"
                android:textColor="@color/bujo_text"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
