<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- Left 30% Dimmed Scrim (Click to dismiss) -->
    <View
        android:id="@+id/sidebar_dim_scrim"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:background="@color/bb10_sidebar_scrim"
        android:clickable="true"
        android:focusable="true" />

    <!-- Right 70% BB10 Sidebar Container -->
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:background="@color/bb10_sidebar_dark_bg">

        <!-- 1. TOP SECTION: Task / Item Title -->
        <LinearLayout
            android:id="@+id/sidebar_top_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:padding="16dp"
            android:background="@color/bb10_sidebar_header_bg">

            <TextView
                android:id="@+id/sidebar_task_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/bb10_sidebar_on_background"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <View
            android:id="@+id/top_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/sidebar_top_section"
            android:background="@color/bb10_sidebar_divider" />

        <!-- 3. BOTTOM SECTION: Fixed Delete Button -->
        <LinearLayout
            android:id="@+id/sidebar_bottom_delete"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@color/bb10_sidebar_on_background"  android:contentDescription="@null" android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/ui_delete_f6fdbe"
                android:textColor="@color/bb10_sidebar_on_background"
                android:textSize="16sp" />
        </LinearLayout>

        <View
            android:id="@+id/bottom_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_above="@id/sidebar_bottom_delete"
            android:background="@color/bb10_sidebar_divider" />

        <!-- 2. MIDDLE SECTION: Options List (Except Delete) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/top_divider"
            android:layout_above="@id/bottom_divider">

            <ListView
                android:id="@+id/lv_sidebar_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:divider="@color/bb10_sidebar_divider"
                android:dividerHeight="1dp" />
        </RelativeLayout>

    </RelativeLayout>
</LinearLayout>
