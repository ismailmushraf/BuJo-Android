<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bujo_background">

    <!-- Search / Add Habit Bar (BB10 Style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="@color/bb10_bottom_bar_bg">

        <EditText
            android:id="@+id/et_new_habit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:hint="Add a habit..."
            android:textColor="@color/bujo_text"
            android:textSize="14sp"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bujo_divider"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lv_habits"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/bujo_divider"
            android:dividerHeight="1dp"
            android:background="@color/white" />

        <TextView
            android:id="@+id/tv_empty_habits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="No habits tracked yet.\nStart building discipline today."
            android:gravity="center"
            android:textColor="@color/bujo_text_secondary"
            android:textSize="14sp"
            android:visibility="gone"/>

    </RelativeLayout>

</LinearLayout>
