<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bujo_background">

        <!-- Main Fragment Container above the bottom bar -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/bb10_bottom_bar" />

        <!-- BB10 Bottom Action Bar -->
        <LinearLayout
            android:id="@+id/bb10_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/bb10_bottom_bar_bg">

            <!-- Left Button (Back) and Slanted Blue Separator -->
            <LinearLayout
                android:id="@+id/btn_bb10_back"
                android:contentDescription="@string/ui_back_b52b36"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="16dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_bb10_back"
                    app:tint="@color/bujo_text"  android:contentDescription="@null" android:importantForAccessibility="no" />

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_bb10_separator"
                    android:scaleType="fitCenter"
                    android:layout_marginStart="8dp"  android:contentDescription="@null" android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- Projects Button -->
            <LinearLayout
                android:id="@+id/btn_bb10_projects"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal|bottom"
                android:paddingBottom="4dp"
                android:visibility="gone"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="2dp"
                    android:src="@drawable/ic_project"
                    app:tint="@color/bujo_text"  android:contentDescription="@null" android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_projects_53e890"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:textColor="@color/bujo_text" />
            </LinearLayout>

            <!-- Habits Button -->
            <LinearLayout
                android:id="@+id/btn_bb10_habits"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal|bottom"
                android:paddingBottom="4dp"
                android:visibility="gone"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="2dp"
                    android:src="@drawable/ic_habits"
                    app:tint="@color/bujo_text"  android:contentDescription="@null" android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_habits_45ab39"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:textColor="@color/bujo_text" />
            </LinearLayout>

            <!-- Pomodoro Balance Spacers 1 and 2 -->
            <View
                android:id="@+id/space_bb10_pomodoro_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:visibility="gone" />

            <View
                android:id="@+id/space_bb10_pomodoro_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:visibility="gone" />

            <!-- Center Anchor / Text space for FAB -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal|bottom"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tv_bb10_fab_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_new_task_cc3dbd"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:textColor="@color/bujo_text" />
            </LinearLayout>

            <!-- Reset Button (Focus Timer Only, Right of Center FAB in Workouts Slot) -->
            <LinearLayout
                android:id="@+id/btn_bb10_reset"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal|bottom"
                android:paddingBottom="4dp"
                android:visibility="gone"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_bb10_reset_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="2dp"
                    android:src="@drawable/ic_bb10_reset"
                    app:tint="@color/bujo_text"
                    android:clickable="false"
                    android:focusable="false"  android:contentDescription="@null" android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tv_bb10_reset_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_reset_44c57a"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:textColor="@color/bujo_text"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <!-- Pomodoro Balance Spacer 5 -->
            <View
                android:id="@+id/space_bb10_pomodoro_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:visibility="gone" />

            <!-- Workouts Button -->
            <LinearLayout
                android:id="@+id/btn_bb10_workouts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal|bottom"
                android:paddingBottom="4dp"
                android:visibility="gone"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="2dp"
                    android:src="@drawable/ic_workout"
                    app:tint="@color/bujo_text"  android:contentDescription="@null" android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_workouts_ccb58b"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:textColor="@color/bujo_text" />
            </LinearLayout>

            <!-- Settings Button -->
            <LinearLayout
                android:id="@+id/btn_bb10_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal|bottom"
                android:paddingBottom="4dp"
                android:visibility="gone"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="2dp"
                    android:src="@drawable/ic_bb10_gear"
                    app:tint="@color/bujo_text"  android:contentDescription="@null" android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_settings_c7f73b"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:textColor="@color/bujo_text" />
            </LinearLayout>

            <!-- Right Button (Overflow) -->
            <LinearLayout
                android:id="@+id/btn_bb10_overflow"
                android:contentDescription="@string/ui_more_options_86c0a3"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_bb10_more"
                    app:tint="@color/bujo_text" android:contentDescription="@null" android:importantForAccessibility="no" />
            </LinearLayout>

        </LinearLayout>

        <!-- Protruding Central FAB -->
        <ImageView
            android:id="@+id/bb10_fab"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="22dp"
            android:background="@drawable/bb10_fab_layer"
            android:src="@drawable/ic_bb10_compose"
            app:tint="@color/on_accent"
            android:scaleType="center"
            android:clickable="true"
            android:focusable="true"
            android:elevation="0dp"  android:contentDescription="@string/ui_new_task_17b2b8" />

    </RelativeLayout>

    <!-- Navigation Drawer -->
    <RelativeLayout
        android:id="@+id/nav_drawer_container"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/bb10_sidebar_dark_bg">

        <ListView
            android:id="@+id/nav_drawer_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:divider="@color/bb10_sidebar_divider"
            android:dividerHeight="1dp" />
    </RelativeLayout>

</androidx.drawerlayout.widget.DrawerLayout>
