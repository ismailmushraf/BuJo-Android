<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bujo_background">

        <!-- Main Fragment Container above the bottom bar -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/bb10_bottom_bar" />

        <!-- BB10 Bottom Action Bar -->
        <LinearLayout
            android:id="@+id/bb10_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/bb10_bottom_bar_bg">

            <!-- Left Button (Back) and Slanted Blue Separator -->
            <LinearLayout
                android:id="@+id/btn_bb10_back"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="16dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_bb10_back"
                    android:tint="@color/bujo_text" />

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_bb10_separator"
                    android:scaleType="fitCenter"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Projects Button -->
            <LinearLayout
                android:id="@+id/btn_bb10_projects"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal|bottom"
                android:paddingBottom="4dp"
                android:visibility="gone"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="2dp"
                    android:src="@drawable/ic_project"
                    android:tint="@color/bujo_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Projects"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:textColor="@color/bujo_text" />
            </LinearLayout>

            <!-- Habits Button -->
            <LinearLayout
                android:id="@+id/btn_bb10_habits"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal|bottom"
                android:paddingBottom="4dp"
                android:visibility="gone"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="2dp"
                    android:src="@drawable/ic_habits"
                    android:tint="@color/bujo_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Habits"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:textColor="@color/bujo_text" />
            </LinearLayout>

            <!-- Center Anchor / Text space for FAB -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal|bottom"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tv_bb10_fab_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New Task"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:textColor="@color/bujo_text" />
            </LinearLayout>

            <!-- Workouts Button -->
            <LinearLayout
                android:id="@+id/btn_bb10_workouts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal|bottom"
                android:paddingBottom="4dp"
                android:visibility="gone"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="2dp"
                    android:src="@drawable/ic_workout"
                    android:tint="@color/bujo_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Workouts"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:textColor="@color/bujo_text" />
            </LinearLayout>

            <!-- Settings Button -->
            <LinearLayout
                android:id="@+id/btn_bb10_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal|bottom"
                android:paddingBottom="4dp"
                android:visibility="gone"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="2dp"
                    android:src="@drawable/ic_bb10_gear"
                    android:tint="@color/bujo_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:textColor="@color/bujo_text" />
            </LinearLayout>

            <!-- Right Button (Overflow) -->
            <LinearLayout
                android:id="@+id/btn_bb10_overflow"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_bb10_more"
                    android:tint="@color/bujo_text"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Protruding Central FAB -->
        <ImageView
            android:id="@+id/bb10_fab"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="22dp"
            android:background="@drawable/bb10_fab_layer"
            android:src="@drawable/ic_bb10_compose"
            android:tint="@color/white"
            android:scaleType="center"
            android:clickable="true"
            android:focusable="true"
            android:elevation="0dp" />

    </RelativeLayout>

    <!-- Navigation Drawer -->
    <ListView
        android:id="@+id/nav_drawer_list"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#000000"
        android:divider="#222222"
        android:dividerHeight="1dp" />

</android.support.v4.widget.DrawerLayout>
