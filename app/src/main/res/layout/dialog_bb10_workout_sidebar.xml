<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- Left Dimmed Scrim -->
    <View
        android:id="@+id/sidebar_dim_scrim"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:background="@color/bb10_sidebar_scrim"
        android:clickable="true"
        android:focusable="true" />

    <!-- Right Container -->
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:background="@color/bb10_sidebar_dark_bg">

        <!-- Top Fixed Header -->
        <LinearLayout
            android:id="@+id/sidebar_top_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/bb10_sidebar_header_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Workouts"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:id="@+id/top_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/sidebar_top_section"
            android:background="@color/bb10_sidebar_divider" />

        <!-- Centered Options List -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/top_divider">

            <ListView
                android:id="@+id/lv_sidebar_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:divider="@color/bb10_sidebar_divider"
                android:dividerHeight="1dp" />
        </RelativeLayout>

    </RelativeLayout>
</LinearLayout>