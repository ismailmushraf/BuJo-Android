<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/shape_bujo_page"
    android:padding="24dp"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_symbol_ee3533"
        android:textSize="40sp" />

    <TextView
        android:id="@+id/bonus_points_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_0_pts_959ddf"
        android:textColor="@color/literal_4caf50"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_commitment_bonus_added_9da085"
        android:textColor="@color/bujo_text"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginTop="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_your_commitment_points_are_already_recorded_024dc2"
        android:textColor="@color/bujo_text_secondary"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <Button
        style="@style/Widget.BuJo.Button.Standard"
        android:id="@+id/btn_bonus_collect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_continue_2e0262"
        android:layout_marginTop="20dp"
        android:textColor="@color/bujo_text"
        android:textAllCaps="true"
        android:textStyle="bold" />

</LinearLayout>
