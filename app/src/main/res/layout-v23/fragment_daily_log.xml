<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bujo_background">

    <!-- Search / Add Bar (BB10 Style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="@color/bb10_bottom_bar_bg">
        <EditText
            android:id="@+id/et_new_entry"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/surface"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:hint="@string/ui_add_a_task_or_search_71bb11"
            android:textSize="16sp"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:singleLine="true" />

        <Button
            android:id="@+id/btn_plan_tomorrow"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/plan_day_txt"
            android:textSize="12sp"
            android:textColor="@color/bujo_text"
            android:background="@drawable/shape_bb10_btn_layer"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/coach_active_plan_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="@drawable/shape_coach_bubble"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/bb10_blue" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/coach_active_plan_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY'S AI FOCUS PLAN"
                android:textColor="@color/bujo_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/coach_active_plan_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/bujo_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Active List Window -->
    <ListView
        android:id="@+id/lv_daily_bullets"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/bujo_divider"
        android:dividerHeight="1dp" />

</LinearLayout>
