<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cyan Pill Track -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00a8df" />
            <corners android:radius="14dp" />
            <size
                android:width="44dp"
                android:height="24dp" />
        </shape>
    </item>

    <!-- White Thumb Circle on Right -->
    <item
        android:top="2dp"
        android:bottom="2dp"
        android:right="2dp"
        android:left="22dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
